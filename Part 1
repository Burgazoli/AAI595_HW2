#Method 1: Normal Equation  
def normal_equation(x, y):
  w = np.linalg.inv(x.T.dot(x)).dot(x.T).dot(y)
  return w

#This is the code for the normal linear regression.

def calculate_mse(x, y, weights):
  predictions = x.dot(weights)
  mse = np.mean((predictions - y) ** 2)
  return mse

def batch_gradient_descent(x, y, learning_rate, num_iterations):
  num_samples, num_features = x.shape
  w = np.zeros(num_features) #Initialize weights to zero
  mse_history = []

  for _ in range(num_iterations):
    predictions = x.dot(w)
    gradient = (1/num_samples) * x.T.dot(predictions - y)
    w -= learning_rate * gradient
    mse = calculate_mse(x, y, w)
    mse_history.append(mse)

  return w, mse_history

def stochastic_gradient_descent(x, y, learning_rate, num_iterations):
  num_samples, num_features = x.shape
  w = np.zeros(num_features) #Initialize weights to zero
  mse_history = []

  for _ in range(num_iterations):
    for i in range(num_samples):
      random_index = np.random.radiant(0, num_samples)
      xi = x[random_index:random_index+1]
      yi = y[random_index:random_index+1]
      prediction = xi.dot(w)
      gradient = xi.T.dot(prediction - yi)
    mse = calculate_mse(x, y, w)
    mse_history.append(mse)

  return w, mse_history
  
